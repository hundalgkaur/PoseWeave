# PoseWeave environment configuration.
# Copy this file to `.env` (which is git-ignored) and fill in your key.
#
#   cp .env.example .env
#
# Google Gemini API key — used for AI gait/posture recommendations.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest, a
# stable alias that tracks the current Flash model and avoids 404s when a
# pinned version is retired). Examples: gemini-flash-latest, gemini-2.0-flash.
GEMINI_MODEL=gemini-flash-latest
